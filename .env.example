OLLAMA_HOST=http://localhost:11434
CHAT_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text
CHROMA_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=60

# Asymmetric prefixes recommended by the nomic-embed-text model card.
# Leave both empty when using an embedding model that does not need them.
EMBEDDING_QUERY_PREFIX="search_query: "
EMBEDDING_DOCUMENT_PREFIX="search_document: "
APP_HOST=127.0.0.1
APP_PORT=8000

# Security (recommended in corp / shared deployments).
# Leave API_KEY empty for local dev; set any non-empty string to require an
# X-API-Key header on /api/documents, /api/repositories and /api/chat.
API_KEY=
# Strict CORS allowlist (no wildcards). Comma-separated JSON list.
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
# Per-IP rate limits (slowapi syntax).
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_UPLOADS=10/minute
