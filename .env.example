OLLAMA_HOST=http://localhost:11434
CHAT_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text
CHROMA_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=8

# Retrieval mode:
#   vector (default) - dense embeddings only.
#   hybrid           - dense + BM25 lexical, fused via Reciprocal Rank
#                      Fusion. Helps with rare-token queries (function
#                      names, error codes); costs an in-memory BM25
#                      corpus rebuild after every write.
RETRIEVAL_MODE=vector

# In-memory LRU + TTL cache for /api/search and /api/query responses.
# Wipes itself on every ingest / delete / wipe so stale answers never
# survive an index change.
CACHE_ENABLED=false
CACHE_MAX_ENTRIES=256
CACHE_TTL_SECONDS=300

# Cross-encoder reranker run after retrieval. NullReranker is the
# default (pass-through, zero cost). Enabling FlashRank triggers a
# one-time ONNX model download (~80 MB) cached under reranker_cache_dir.
RERANKER_ENABLED=false
RERANKER_MODEL=ms-marco-MiniLM-L-12-v2
RERANKER_TOP_K=5
RERANKER_CACHE_DIR=

# Asymmetric prefixes recommended by the nomic-embed-text model card.
# Leave both empty when using an embedding model that does not need them.
EMBEDDING_QUERY_PREFIX="search_query: "
EMBEDDING_DOCUMENT_PREFIX="search_document: "

# Tenacity-driven retry on transient Ollama errors (ReadTimeout,
# ConnectError, RemoteProtocolError). Exponential backoff between
# min_seconds and max_seconds; the first attempt fires immediately.
OLLAMA_RETRY_ATTEMPTS=3
OLLAMA_RETRY_BACKOFF_MIN_SECONDS=1.0
OLLAMA_RETRY_BACKOFF_MAX_SECONDS=8.0
APP_HOST=127.0.0.1
APP_PORT=8000

# Security (recommended in corp / shared deployments).
# Leave API_KEY empty for local dev; set any non-empty string to require an
# X-API-Key header on /api/documents, /api/repositories and /api/chat.
API_KEY=
# Strict CORS allowlist (no wildcards). Comma-separated JSON list.
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
# Per-IP rate limits (slowapi syntax).
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_UPLOADS=10/minute

# Interactive login (POST /api/auth/login). Both AUTH_PASSWORD and
# JWT_SECRET must be set to enable the bearer flow; leave them empty for
# the service-to-service `X-API-Key` flow only.
AUTH_USERNAME=admin
AUTH_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_MINUTES=60

# Set to "false" in production to disable /docs and /redoc.
DOCS_ENABLED=true
